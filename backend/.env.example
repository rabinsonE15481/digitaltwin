# Copy this file to .env and fill it in. Never commit or share .env.
OPENAI_API_KEY=sk-REPLACE-ME

# Verify the exact model IDs your account has:  python -c "from openai import OpenAI; print([m.id for m in OpenAI().models.list()])"
ROUTER_MODEL=gpt-6-luna
ANSWER_MODEL=gpt-6.1-sol
REASONING_EFFORT=low
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

TEACHER_NAME=Malathy ma'am
SUBJECT=Physics

# Her cloned voice (ElevenLabs). Leave empty to use OpenAI's standard voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.85

# Her live talking face (LemonSlice + LiveKit). Leave empty to use the free photo avatar.
# Needs a long-running backend (uvicorn locally / EC2) - not AWS Lambda.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LEMONSLICE_API_KEY=
LEMONSLICE_IMAGE_URL=
AVATAR_IDLE_SECONDS=300

# After hosting the frontend, set this to its https URL (comma-separate several). * = allow all (testing only).
ALLOWED_ORIGINS=*
SESSION_SECONDS=600
